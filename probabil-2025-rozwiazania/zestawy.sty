\newcommand{\stirlingi}[2]{\genfrac{[}{]}{0pt}{}{#1}{#2}}
\newcommand{\stirlingii}[2]{\genfrac{\{}{\}}{0pt}{}{#1}{#2}}
\newcommand{\multibinom}[2]{\left(\!\! \binom{#1}{#2} \!\!\right)}
\newcommand{\euler}[2]{\genfrac{\langle}{\rangle}{0pt}{}{#1}{#2}}

% \gfsum{A}{m}{a}{k} = \gffrac{A}{m}{a}{k}
\newcommand{\gfsum}[4]{
  \sum_{n=0}^{\infty}
    \mathit{ \color{Red} #1}
    \binom{n+\mathit{\color{Green} #2}-1}{\mathit{\color{Green} #2} - 1}
    \mathit{\color{Blue} #3}^n
    x^{\mathit{\color{Magenta} #4}n}
}
\newcommand{\gffrac}[4]{
  \frac{\mathit{\color{Red}{#1}}}
  {
    \left( 1 - \mathit{\color{Blue} #3}x^\mathit{\color{Magenta} #4 } \right)
    ^{\mathit{\color{Green} #2}
  }}
}
